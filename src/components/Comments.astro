---
// Comments powered by Giscus, backed by GitHub Discussions on this repo —
// no database, no accounts to build, moderation happens on GitHub itself.
//
// TODO before this works: the two data- values below are placeholders.
// See CONTENT_PLAYBOOK.md for the 3-step setup, then swap in the real
// data-repo-id / data-category-id giscus.app generates for this repo.
---
<section class="comments">
  <p class="eyebrow">leave a note</p>
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="threehappyyou-blip/thegeolog-site"
    data-repo-id="TODO_REPO_ID"
    data-category="Comments"
    data-category-id="TODO_CATEGORY_ID"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="light"
    data-lang="en"
    crossorigin="anonymous"
    async
  ></script>
</section>

<style>
  .comments {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
</style>
